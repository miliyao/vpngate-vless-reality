PANEL_PORT=3000
PANEL_AUTH_ENABLED=true
PANEL_USERNAME=admin
PANEL_PASSWORD=change-this-password

# Optional: force subscription links to use this public address instead of Host header.
VPS_ADDRESS=

# Reality SNI and destination domain.
RE_DOMAINS=www.amd.com

# Absolute path to this repository's data directory on the host.
HOST_DATA_PATH=/root/vpngate-vless-reality/data
